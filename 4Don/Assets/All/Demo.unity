    - target: {fileID: 1752643961181687453, guid: 6c17b42b56e2889469df505cfb953b29, type: 3}
      propertyPath: m_text
      value: "\"\uCCA0\uADFC\uB9CC \uB204\uB77D\uD55C \uAC8C \uC544\uB2C8\uB124\" 
        LH \uC544\uD30C\uD2B8 \uD558\uC790 2\uB144 \uC0C8 \uAE09\uC99D"
      objectReference: {fileID: 0}
    - target: {fileID: 1861257269314609200, guid: 6c17b42b56e2889469df505cfb953b29, type: 3}
      propertyPath: m_text
      value: "\uCC44\uD638\uC5D0\uC5B4, \uD56D\uACF5 \uB9C8\uC77C\uB9AC\uC9C0 \uAC1C\uD3B8
        \uB17C\uB780"
      objectReference: {fileID: 0}
    - target: {fileID: 2060719332805882274, guid: 6c17b42b56e2889469df505cfb953b29, type: 3}
      propertyPath: m_text
      value: "\uC815\uBD80\uC758 \uACBD\uC81C\uC815\uCC45\uC774 \uBB3C\uAC00 \uC548\uC815\uC744
        \uC6B0\uC120\uC2DC\uD558\uBA74\uC11C \uACBD\uAE30 \uBD80\uC591 \uACC4\uD68D\uC5D0
        \uCC28\uC9C8\uC744 \uBE5A\uACE0 \uC788\uB2E4. \n\n\uC911\uAD6D\uC758 \uACBD\uACC4
        \uD65C\uB3D9 \uC7AC\uAC1C\uC640 \uBBF8\uAD6D \uBC0F \uC2A4\uD398\uC778\uC758
        \uBB3C\uAC00 \uC0C1\uC2B9\uC774 \uAE00\uB85C\uBC8C \uC778\uD50C\uB808\uC774\uC158
        \uC7AC\uD655\uC0B0 \uC6B0\uB824\uB97C \uD0A4\uC6B0\uACE0 \uC788\uC73C\uBA70,
        \uD55C\uAD6D \uB0B4\uBD80\uC801\uC73C\uB85C\uB3C4 \uACF5\uACF5\uC694\uAE08\uACFC
        \uC2DD\uC74C\uB8CC \uAC00\uACA9 \uC778\uC0C1\uC73C\uB85C \uBB3C\uAC00 \uC0C1\uC2B9
        \uC555\uB825\uC774 \uC9C0\uC18D\uB418\uACE0 \uC788\uB2E4. \n\n\uCD94\uD604\uD638
        \uACBD\uC81C\uBD80\uCD1D\uB9AC\uB294 \uBB3C\uAC00 \uC548\uC815\uC744 \uAC15\uC870\uD558\uBA70
        \uCDE8\uC57D\uACC4\uCE35 \uBCF4\uD638\uC758 \uC911\uC694\uC131\uC744 \uC5B8\uAE09\uD588\uB2E4.
        \n\n\uD55C\uAD6D\uC740 \uACF5\uACF5\uC694\uAE08 \uC778\uC0C1\uACFC \uC8FC\uB958,
        \uC2DD\uD488 \uAC00\uACA9 \uC0C1\uC2B9\uC73C\uB85C \uC778\uD574 \uC18C\uBE44\uC790\uBB3C\uAC00\uC9C0\uC218\uAC00
        \uC804\uB144 \uB3D9\uC6D4 \uB300\uBE44 5.2%\uC0C1\uC2B9\uD588\uC73C\uBA70,
        \uC815\uBD80\uB294 \uBB3C\uAC00 \uC548\uC815\uC744 \uC704\uD574 \uACF5\uACF5\uC694\uAE08
        \uBD84\uD560\uB0A9\uBD80 \uB300\uC0C1\uD655\uB300\uC640 \uC0C1\uBC18\uAE30
        \uACF5\uACF5\uC694\uAE08...."
      objectReference: {fileID: 0}
    - target: {fileID: 2517949805721539754, guid: 6c17b42b56e2889469df505cfb953b29, type: 3}
      propertyPath: m_text
      value: "\uC5EC\uC6D0\uD478\uB4DC\uAC00 2020\uB144 \uC5F0\uACB0 \uAE30\uC900
        \uB9E4\uCD9C 9090\uC5B5\uC6D0, \uC21C\uC774\uC775 803\uC5B5\uC6D0\uC744 \uAE30\uB85D\uD574
        \uC5ED\uB300 \uCD5C\uB300 \uB9E4\uCD9C\uC744 \uB2EC\uC131\uD588\uB2E4. \uC774\uB294
        \uC5EC\uC6D0\uB77C\uBA74\uC758 \uD574\uC678 \uC778\uAE30\uC640 \uC6D0,\uB2EC\uB7EC
        \uD658\uC728 \uC0C1\uC2B9\uC5D0 \uB530\uB978 \uD658\uCC28\uC775 \uB54C..."
      objectReference: {fileID: 0}
    - target: {fileID: 2555697974489414151, guid: 6c17b42b56e2889469df505cfb953b29, type: 3}
      propertyPath: m_text
      value: "\uC62C\uD574 \uBCF4\uC601\uBC14\uC774\uC624\uC758 \uC8FC\uAC00\uB294
        35.3% \uD558\uB77D\uD558\uBA70, \uCF54\uB85C\uB098 \uBC31\uC2E0 '\uCF54\uBBF8\uB098\uD2F0'\uC640 
        \uCE58\uB8CC\uC81C'\uD30D\uC2A4\uB85C\uBE44\uB4DC' \uD310\uB9E4 \uAC10\uC18C\uB85C
        2\uBD84\uAE30 \uC2E4\uC801\uC774 53% \uAE09\uAC10\uD588\uB2E4. \uC62C\uD574
        \uCF54\uB85C\uB098 \uAD00\uB828 \uB9E4\uCD9C\uC740 215\uC5B5\uB2EC\uB7EC\uB85C.."
      objectReference: {fileID: 0}
