  category: {fileID: 11400000, guid: c2edeadc821b3c14090b7afd31025d49, type: 2}
  codeName: MakeAccount
  displayName: "\uC608\uC0B0 \uAD00\uB9AC\uC758 \uC2DC\uC791"
  description: "\uC740\uD589\uC5D0\uC11C \uACC4\uC88C\uB97C \uB9CC\uB4E4\uC5B4\uBCF4\uC790!"
  directions: []
  goal: 
  position: 2
  action: {fileID: 11400000, guid: 93ba6872ce644cf49a5e71a6211b689c, type: 2}
  targets:
  - {fileID: 11400000, guid: 6d0ec46f78236b84399041686f43b041, type: 2}
  beforDialogueLines:
  - speaker: "\uC548\uB0B4\uC6D0"
    dialogue:
    - "\uB3C8\uC744 \uBC8C\uC5C8\uC73C\uB2C8 \uC774\uC81C \uC18C\uB4DD\uC744 \uC798
      \uAD00\uB9AC\uD558\uB294 \uAC8C \uC815\uB9D0 \uC911\uC694\uD574! \uC790\uC0B0
      \uAD00\uB9AC\uB294 \uB108\uC758 \uBBF8\uB798\uB97C \uC704\uD574 \uAF2D \uD544\uC694\uD55C
      \uBD80\uBD84\uC774\uC57C. "
    - "\uC18C\uB4DD\uC744 \uAD00\uB9AC\uD558\uB294 \uBC29\uBC95\uC5D0\uB294 \uC800\uCD95\uACFC
      \uD22C\uC790\uAC00 \uC788\uC5B4. \uC800\uCD95\uC740 \uB098\uC911\uC5D0 \uD544\uC694\uD55C
      \uB3C8\uC744 \uC900\uBE44\uD560 \uB54C \uC88B\uACE0 \uD22C\uC790\uB294 \uC790\uC0B0\uC744
      \uBD88\uB824\uB098\uAC08 \uB54C \uD544\uC694\uD55C \uBC29\uBC95\uC774\uC57C."
    - "\uC5EC\uAE30 \uBA54\uD0C0 \uB9C8\uC744\uC5D0\uC11C\uB294 \uC740\uD589\uC5D0\uC11C
      \uC800\uCD95\uACFC \uD22C\uC790 \uBAA8\uB450 \uD560 \uC218 \uC788\uC5B4. \uADF8\uB7FC
      \uC740\uD589\uC5D0 \uAC00\uC11C \uB124 \uACC4\uC88C\uB97C \uAC1C\uC124\uD574\uBCFC\uAE4C?"
    options: []
    currentState: 0
    changedState: 1
    eventNum: {x: 0, y: 0}
  IngDialogueLines:
  - speaker: "\uC548\uB0B4\uC6D0"
    dialogue:
    - "\uC5B4\uC11C \uAC00\uC11C \uACC4\uC88C \uAC1C\uC124\uC744 \uD574\uBCF4\uC790!"
    options: []
    currentState: 1
    changedState: 1
    eventNum: {x: 0, y: 0}
  AfterDialogueLines:
  - speaker: "\uC740\uD589\uC6D0"
    dialogue:
    - "\uC548\uB155\uD558\uC138\uC694 \uBA54\uD0C0\uBC45\uD06C\uC785\uB2C8\uB2E4.
      \uC800\uD76C \uC740\uD589\uC5D0 \uCC98\uC74C \uC624\uC2E0 \uAC74\uAC00\uC694?"
    options:
    - optionText: "\uB124 \uCC98\uC74C \uC654\uC5B4\uC694!"
      nextDialogue:
      - speaker: "\uC740\uD589\uC6D0"
        dialogue:
        - "\uCC98\uC74C \uC624\uC168\uB2E4\uBA74 \uACC4\uC88C \uAC1C\uC124\uC744
          \uB3C4\uC640\uB4DC\uB9B4\uAC8C\uC694! \uACC4\uC88C\uB97C \uAC1C\uC124\uD558\uB824\uBA74
          \uBA3C\uC800 \uC57D\uAD00\uC5D0 \uB3D9\uC758\uD558\uC154\uC57C \uD574\uC694."
        - "@\uC57D\uAD00\uB0B4\uC6A9\uC744 \uAF3C\uAF3C\uD558\uAC8C \uC77D\uC5B4\uBCF4\uC2DC\uACE0
          \uB3D9\uC758\uD574 \uC8FC\uC138\uC694!"
        - "\uACC4\uC88C\uAC00 \uAC1C\uC124\uB418\uC5C8\uC2B5\uB2C8\uB2E4! \uC774\uC81C
          \uC774\uACF3\uC5D0\uC11C \uC18C\uB4DD\uC744 \uC800\uCD95\uD558\uACE0 \uD22C\uC790\uD560
          \uC218 \uC788\uC2B5\uB2C8\uB2E4."
        - "\uC774\uB807\uAC8C \uBAA8\uC740 \uB3C8\uC774 \uCC28\uACE1\uCC28\uACE1
          \uC313\uC774\uBA74 \uB354 \uD070 \uBAA9\uD45C\uB3C4 \uC774\uB8F0 \uC218
          \uC788\uC5B4\uC694. \uC740\uD589\uC740 \uC790\uC0B0\uC744 \uC548\uC804\uD558\uAC8C
          \uAD00\uB9AC\uD558\uACE0 \uBD88\uB824\uAC00\uB294 \uB370 \uAF2D \uD544\uC694\uD55C
          \uACF3\uC774\uC5D0\uC694!"
        options: []
        currentState: 2
        changedState: 3
        eventNum: {x: 2, y: 0}
      optioneventNum: {x: 0, y: 0}
    - optionText: "\uC544\uB1E8, \uC774\uBBF8 \uC628 \uC801\uC774 \uC788\uC5B4\uC694!"
      nextDialogue:
      - speaker: "\uC740\uD589\uC6D0"
        dialogue:
        - "\uC544\uD558! \uC5B4\uB5A4 \uD65C\uB3D9\uC744 \uC6D0\uD558\uC2DC\uB294
          \uAC78\uAE4C\uC694?"
        options: []
        currentState: 2
        changedState: 3
        eventNum: {x: 0, y: 0}
      optioneventNum: {x: 0, y: 0}
