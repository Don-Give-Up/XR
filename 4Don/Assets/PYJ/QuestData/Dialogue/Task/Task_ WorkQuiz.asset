  - {fileID: 11400000, guid: 08d35856ed9b44e4c8407114fa242714, type: 2}
  beforDialogueLines:
  - speaker: "\uC548\uB0B4\uC6D0"
    dialogue:
    - "\uC774\uC81C \uBA54\uD0C0 \uB9C8\uC744\uC5D0\uC11C \uAE08\uC735 \uD65C\uB3D9\uC744
      \uD560 \uCC28\uB840\uC57C! "
    - "\uAE08\uC735 \uD65C\uB3D9\uC774\uB780 \uB3C8\uC744 \uBC8C\uACE0 \uC18C\uBE44\uD558\uACE0
      \uD22C\uC790\uD558\uB294 \uBAA8\uB4E0 \uACFC\uC815\uC744 \uC758\uBBF8\uD574."
    - "\uC774 \uC911\uC5D0\uC11C \uAC00\uC7A5 \uC911\uC694\uD55C \uAC74 \uB178\uB3D9
      \uC989, '\uB3C8\uC744 \uBC84\uB294 \uAC83'\uC774\uC57C"
    - "\uBA54\uD0C0 \uB9C8\uC744\uC5D0\uC11C \uB3C8\uC744 \uBC8C\uB824\uBA74 \uD034\uC988\uB97C
      \uD480\uC5B4\uC57C \uD574."
    - "\uD034\uC988\uB294 \uD034\uC988\uC7A5\uC5D0 \uAC00\uC11C \uD480 \uC218 \uC788\uC5B4.
      \uC900\uBE44\uB410\uB2C8?"
    options: []
    currentState: 0
    changedState: 1
    eventNum: {x: 0, y: 0}
  IngDialogueLines:
  - speaker: "\uC548\uB0B4\uC6D0"
    dialogue:
    - "\uD034\uC988\uB294 \uD480\uC5B4\uBD24\uB2C8? \uD034\uC988\uB294 \uAE08\uC735
      \uC9C0\uC2DD\uC744 \uC810\uAC80\uD560 \uC218 \uC788\uB294 \uAE30\uD68C\uC774\uAE30\uB3C4
      \uD574"
    - "\uC5B4\uC11C \uD034\uC988\uB97C \uD480\uB7EC\uAC00\uBD10!"
    options: []
    currentState: 1
    changedState: 1
    eventNum: {x: 0, y: 0}
  AfterDialogueLines:
  - speaker: "\uC548\uB0B4\uC6D0"
    dialogue:
    - "\uC218\uACE0\uD588\uC5B4! \uAE08\uC735 \uC9C0\uC2DD\uC774 \uD55C\uCE35 \uB354
      \uB192\uC544\uC9C4 \uAE30\uBD84\uC774\uC9C0? "
    - "\uD639\uC2DC \uD2C0\uB9B0 \uBB38\uC81C\uAC00 \uC788\uB2E4\uBA74 \uBD84\uC11D\uB808\uD3EC\uD2B8\uC5D0\uC11C
      \uC124\uBA85\uD574 \uC904\uD14C\uB2C8 \uAC71\uC815\uB9C8. "
