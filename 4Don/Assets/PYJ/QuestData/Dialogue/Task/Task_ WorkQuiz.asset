  displayName: "\uC18C\uB4DD\uC758 \uC8FC \uC218\uC785\uC6D0\uC740 \uB178\uB3D9"
  description: "O/X \uD034\uC988\uD480\uAE30"
  directions:
  - "\uD034\uC988 \uD480\uC774\uC7A5\uC73C\uB85C \uC774\uB3D9\uD558\uAE30"
  - "\uAE08\uC735 O/X \uD034\uC988 \uD480\uAE30"
  goal: "\uD034\uC988\uB97C \uD1B5\uD574 \uAE08\uC735 \uC9C0\uC2DD\uC744 \uC810\uAC80\uD574\uBCF4\uC790"
