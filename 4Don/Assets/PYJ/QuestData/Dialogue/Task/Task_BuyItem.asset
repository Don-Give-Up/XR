  beforDialogueLines:
  - speaker: "\uC548\uB0B4\uC6D0"
    dialogue:
    - "\uC774\uB807\uAC8C \uC800\uCD95\uC774\uB098 \uD22C\uC790\uB97C \uD1B5\uD574
      \uC790\uC0B0\uC744 \uD0A4\uC6B0\uBA74 \uC6D0\uD558\uB294 \uC0C1\uD488\uC744
      \uAD6C\uB9E4\uD560 \uC218 \uC788\uC5B4 "
    - "\uB2F9\uC5F0\uD788 \uBA54\uD0C0 \uB9C8\uC744\uC5D0\uB3C4 \uC0C1\uC810\uC774
      \uC788\uC9C0. \uC0C1\uC810\uC5D0\uC120 \uC120\uC0DD\uB2D8\uC758 \uCFE0\uD3F0\uC744
      \uC0B4 \uC218 \uC788\uC5B4."
    - "\uADF8\uB7FC \uC0C1\uC810\uC73C\uB85C \uC774\uB3D9\uD574\uBCFC\uAE4C? "
    options: []
    currentState: 0
    changedState: 1
    eventNum: {x: 0, y: 0}
  IngDialogueLines:
  - speaker: "\uC548\uB0B4\uC6D0"
    dialogue:
    - "\uAC70\uB798\uB294 \uB2E8\uC21C\uD788 \uBB3C\uAC74\uC744 \uC0AC\uACE0 \uD30C\uB294
      \uAC83\uB9CC\uC774 \uC544\uB2C8\uC57C.  "
    - "\uC0C1\uC810\uC5D0\uC11C \uBB3C\uAC74\uC744 \uC0AC\uACE0 \uD314\uBA74 \uADF8
      \uB3C8\uC774 \uB2E4\uC2DC \uB9C8\uC744\uB85C \uB3CC\uC544\uC640 \uACBD\uC81C\uAC00
      \uD65C\uC131\uD654\uB418\uACE0 \uB354 \uD65C\uAE30\uCC28\uC9C0\uAC8C \uB3FC."
    - "\uC0C1\uC810\uC5D0\uC11C \uBB3C\uAC74\uC744 \uC0AC\uACE0 \uD314\uBA74 \uADF8
      \uB3C8\uC774 \uB2E4\uC2DC \uB9C8\uC744\uB85C \uB3CC\uC544\uC640 \uACBD\uC81C\uAC00
      \uD65C\uC131\uD654\uB418\uACE0 \uB354 \uD65C\uAE30\uCC28\uC9C0\uAC8C \uB3FC."
    - ". \uD544\uC694\uD560 \uB550 \uC544\uB07C\uAE30\uB9CC \uD558\uAE30\uBCF4\uB2E4,
      \uC801\uC7AC\uC801\uC18C\uC5D0 \uC368\uC11C \uAC00\uCE58\uB97C \uB204\uB9AC\uB294
      \uAC83\uB3C4 \uC911\uC694\uD558\uB2E8\uB2E4!"
    options: []
    currentState: 1
    changedState: 1
    eventNum: {x: 0, y: 0}
