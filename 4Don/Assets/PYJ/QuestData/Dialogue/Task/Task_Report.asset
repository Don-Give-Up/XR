  displayName: "\uAC1C\uC778 \uC7AC\uBB34\uAD00\uB9AC"
  description: "\uAE08\uC735 \uB808\uD3EC\uD2B8\uAC00 \uB3C4\uCC29\uD588\uC2B5\uB2C8\uB2E4!"
  directions:
  - "\uD558\uB2E8 \uBA54\uB274\uCC3D\uC744 \uB20C\uB7EC \uBD84\uC11D \uB808\uD3EC\uD2B8\uCC3D
    \uD3BC\uCCD0\uBCF4\uAE30"
  - "\uBD84\uC11D \uB808\uD3EC\uD2B8 \uC77D\uC5B4\uBCF4\uAE30"
  goal: "\uBD84\uC11D \uB808\uD3EC\uD2B8\uB97C \uC77D\uACE0 \uB098\uC758 \uAE08\uC735
    \uD65C\uB3D9\uC744 \uC54C\uC544\uBCF4\uC790"
  position: 0
  action: {fileID: 11400000, guid: 93ba6872ce644cf49a5e71a6211b689c, type: 2}
  targets:
  - {fileID: 11400000, guid: 686a7149a1b961e4ab90f01287346088, type: 2}
  beforDialogueLines:
  - speaker: "\uC548\uB0B4\uC6D0"
    dialogue:
    - "\uB108\uC758 \uAE08\uC735 \uD65C\uB3D9\uC744 \uBD84\uC11D\uD55C \uB808\uD3EC\uD2B8\uAC00
      \uB3C4\uCC29\uD588\uC5B4! \uD558\uB2E8 \uBA54\uB274\uB97C \uD074\uB9AD\uD558\uBA74
      \uB124 \uAE08\uC735 \uB808\uD3EC\uD2B8\uB97C \uD655\uC778\uD560 \uC218 \uC788\uC5B4"
    - "\uC18C\uBE44, \uC800\uCD95, \uD22C\uC790 \uADF8\uB9AC\uACE0 \uD559\uC2B5\uAE4C\uC9C0
      \uB124\uAC00 \uD574\uBCF8 \uB2E4\uC591\uD55C \uD65C\uB3D9\uC5D0 \uB300\uD55C
      \uD53C\uB4DC\uBC31\uC774 \uB2F4\uACA8 \uC788\uC9C0."
    - "\uC5B4\uB5A4 \uC810\uC774 \uC88B\uC558\uACE0 \uB610 \uC5B4\uB514\uC5D0\uC11C
      \uB354 \uAC1C\uC120\uD560 \uC218 \uC788\uC744\uC9C0 \uC0DD\uAC01\uD574\uBCF8\uB2E4\uBA74
      \uC55E\uC73C\uB85C \uB354 \uB098\uC740 \uAE08\uC735 \uC758\uC0AC\uACB0\uC815\uC744
      \uB0B4\uB9B4 \uC218 \uC788\uC744 \uAC70\uC57C!"
    options: []
    currentState: 0
    changedState: 1
    eventNum: {x: 0, y: 0}
  IngDialogueLines:
  - speaker: "\uC548\uB0B4\uC6D0"
    dialogue:
    - "\uC5B4\uC11C \uBD84\uC11D \uB808\uD3EC\uD2B8\uB97C \uD655\uC778\uD574\uBD10!"
    options: []
    currentState: 1
    changedState: 1
    eventNum: {x: 0, y: 0}
  AfterDialogueLines:
  - speaker: "\uC548\uB0B4\uC6D0"
    dialogue:
    - "\uC624\uB298 \uD588\uB358 \uB2E4\uC591\uD55C \uD65C\uB3D9\uB4E4\uACFC \uADF8\uB85C
      \uC778\uD574 \uC313\uC778 \uC18C\uC911\uD55C \uAE08\uC735 \uC9C0\uC2DD\uC744
      \uB5A0\uC62C\uB824\uBD10! \uC774 \uC9C0\uC2DD\uC740 \uACC4\uC18D \uC313\uC774\uACE0 
      \uC810\uC810 \uB354 \uD070 \uBCC0\uD654\uB97C \uC77C\uC73C\uD0AC \uC218 \uC788\uC744
      \uAC70\uC57C. "
    - "\uAD81\uAE08\uD55C \uC810\uC774 \uC0DD\uAE30\uBA74 \uC5B8\uC81C\uB4E0\uC9C0
      \uCC3E\uC544\uC640. \uB0B4\uAC00 \uB3C4\uC640\uC904\uAC8C. \uB2E4\uC2DC\uD55C\uBC88
      \uBA54\uD0C0 \uB9C8\uC744\uC5D0 \uC628 \uAC78 \uD658\uC601\uD574!"
    options: []
    currentState: 2
    changedState: 3
    eventNum: {x: 0, y: 0}
