  AfterDialogueLines:
  - speaker: "\uC548\uB0B4\uC6D0"
    dialogue:
    - "\uC5B4\uC11C \uC640! \uBA54\uD0C0 \uB9C8\uC744\uC758 \uC0C8\uB85C\uC6B4 \uC8FC\uBBFC\uC774
      \uB41C \uAC78 \uD658\uC601\uD574!"
    - "\uB098\uB294 \uB108\uC5D0\uAC8C \uC774\uACF3\uC744 \uC18C\uAC1C\uD574 \uC904
      \uB9C8\uC744 \uC548\uB0B4\uC6D0\uC774\uC57C."
    - "\uC6B0\uB9AC \uB9C8\uC744\uC5D0 \uB300\uD574 \uC54C\uACE0 \uC788\uB2C8?"
    options:
    - optionText: "\uC798 \uBAB0\uB77C. \uC124\uBA85\uD574\uC918!"
      nextDialogue:
      - speaker: "\uC548\uB0B4\uC6D0"
        dialogue:
        - "\uC774\uACF3 \uBA54\uD0C0 \uB9C8\uC744\uC5D0\uC11C\uB294 \uC8FC\uBBFC\uB4E4\uC774
          \uAE08\uC735 \uD65C\uB3D9\uC744 \uD1B5\uD574 \uAE08\uC735 \uC9C0\uC2DD\uC744
          \uC313\uC744 \uB54C\uB9C8\uB2E4 \u2018\uAE08\uC735 \uC5D0\uB108\uC9C0\u2019\uAC00
          \uC313\uC5EC."
        - "\uB3C8\uC744 \uBC8C\uACE0 \uC18C\uBE44\uD558\uB294 \uAC83\uBD80\uD130
          \uC8FC\uC2DD \uD22C\uC790\uC640 \uC800\uCD95\uAE4C\uC9C0 \uB2E4\uC591\uD55C
          \uAE08\uC735 \uD65C\uB3D9\uC5D0 \uCC38\uC5EC\uD558\uBA74\uC11C \uC5BB\uC740
          \uC5D0\uB108\uC9C0\uAC00 \uB9C8\uC744 \uBC1C\uC804\uC758 \uC6D0\uB3D9\uB825\uC774
          \uB3FC."
        - "\uAE08\uC735 \uC9C0\uC2DD\uC740 \uB9C8\uC744\uC5D0\uC11C \uACBD\uC81C\uC640
          \uC790\uC0B0 \uAD00\uB9AC\uC5D0 \uB300\uD574 \uBC30\uC6B0\uB294 \uBAA8\uB4E0
          \uC815\uBCF4\uC57C."
        - "\uB274\uC2A4\uB098 \uD034\uC988\uB97C \uD1B5\uD574 \uC5BB\uC744 \uC218
          \uC788\uC9C0."
        options: []
        currentState: 2
        changedState: 3
        eventNum: {x: 0, y: 0}
      optioneventNum: {x: 0, y: 0}
